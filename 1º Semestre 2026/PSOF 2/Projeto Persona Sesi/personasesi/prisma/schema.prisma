// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Alunos {
  id           Int            @id @default(autoincrement())
  rm           Int            @unique
  nome         String
  serie        Int
  email        String         @unique
  cpf          Int            @unique
  atividades   Atividades[]
  responsaveis Responsaveis[]
}

model Atividades {
  id      Int    @id @default(autoincrement())
  materia String
  media   Float
  tarefas String
  provas  String

  alunos   Alunos @relation(fields: [alunosId], references: [id])
  alunosId Int

  professor   Professores @relation(fields: [professorId], references: [id])
  professorId Int
}

model Professores {
  id         Int    @id @default(autoincrement())
  nome       String
  telefone   String
  disciplina String
  email      String @unique
  cpf        Int    @unique

  atividades Atividades[]

  coordenador   Coordenadores @relation(fields: [coordenadorId], references: [id])
  coordenadorId Int
}

model Coordenadores {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  cpf   Int    @unique

  professores Professores[]
}

model Responsaveis {
  id       Int    @id @default(autoincrement())
  nome     String
  telefone String
  email    String @unique
  cpf      Float    @unique
  rm_aluno Int

  aluno Alunos @relation(fields: [rm_aluno], references: [rm])
}
